.build/
.build-*/
.swiftpm/*
# Except the shared schemes, such as MMClientStackTests for device simulators.
!.swiftpm/xcode/
.swiftpm/xcode/*
!.swiftpm/xcode/xcshareddata/
.index-build/
.DS_Store
*.xcodeproj

# SourceKit-LSP index builds compile the MMCLIGeneratorPlugin output of
# MMCLITests without an output-file-map entry, so the compiler writes these
# into the working directory (an upstream bug).
/MMCLICommands.*
